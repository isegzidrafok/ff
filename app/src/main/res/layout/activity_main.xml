<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hint_permission"
        android:textSize="13sp"
        android:textColor="#444444"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <ToggleButton
        android:id="@+id/toggleInvert"
        android:layout_width="270dp"
        android:layout_height="64dp"
        android:textOn="@string/invert_on"
        android:textOff="@string/invert_off"
        android:textSize="15sp"
        android:layout_marginBottom="28dp" />

    <ToggleButton
        android:id="@+id/toggleDim"
        android:layout_width="270dp"
        android:layout_height="64dp"
        android:textOn="@string/dim_on"
        android:textOff="@string/dim_off"
        android:textSize="15sp" />

</LinearLayout>
